# SafeCampus AI - Backend Flask
# Copia este archivo como backend/.env y rellena los valores.

# Auth - ROTAR antes de produccion (32+ bytes random)
SECRET_KEY=cambiar-esta-clave

# Postgres local (docker-compose levanta esto en :5433)
DATABASE_URL=postgresql://safecampus:safecampus123@localhost:5433/safecampus

# Detector YOLO
CONFIDENCE_THRESHOLD=0.40
MAX_HISTORY=50
CAMERA_INDEX=0
FRAME_SKIP=3
ALERT_COOLDOWN=10
CLEAN_FRAMES_TO_CLEAR=20
TARGET_FPS=30

# Logs
LOG_LEVEL=INFO

# Pre-deploy (descomentar y ajustar)
# ALLOWED_ORIGINS=http://localhost:3000,https://safecampus.vercel.app
# MODEL_URL=https://github.com/<owner>/<repo>/releases/download/v0.1/best.pt
