# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Roboflow demo. Use a Roboflow Universe model/version, for example:
# ROBOFLOW_MODEL_ID=weapon-detection-using-yolov8/1
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=weapon-detection-using-yolov8/1

# Flask backend (detector en vivo con YOLO)
# Dejar en blanco para usar localhost:5000 por defecto
NEXT_PUBLIC_FLASK_URL=http://localhost:5000

# Flask backend config (backend/.env)
# SECRET_KEY=cambiar-esta-clave
# CONFIDENCE_THRESHOLD=0.65
# MAX_HISTORY=50
# CAMERA_INDEX=0
# FRAME_SKIP=3
# ALERT_COOLDOWN=10
# CLEAN_FRAMES_TO_CLEAR=20
